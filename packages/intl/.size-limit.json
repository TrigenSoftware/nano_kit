    "path": "dist/index.js",
    "import": "*",
    "limit": "2 kB"
  },
  {
    "name": "All publics (Brotli)",
    "path": "dist/index.js",
    "import": "*",
    "limit": "1.85 kB"
  },
  {
    "name": "Minimal set (Gzip)",
    "gzip": true,
    "path": "dist/index.js",
