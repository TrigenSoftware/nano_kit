    "limit": "600 B"
  },
  {
    "name": "Minimal set (Brotli)",
    "path": "dist/index.js",
    "import": "{ intl, text, params }",
    "limit": "500 B"
  },
  {
    "name": "Basic set (Gzip)",
    "gzip": true,
    "path": "dist/index.js",
