{
  "name": "@nano_kit/testing",
  "type": "module",
  "version": "0.0.0",
  "description": "Testing tools for stories, tests and demos, starting with a virtual backend.",
  "author": "dangreen",
  "license": "MIT",
  "funding": "https://ko-fi.com/dangreen",
  "repository": {
    "type": "git",
    "url": "https://github.com/TrigenSoftware/nano_kit.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/TrigenSoftware/nano_kit/issues"
  },
  "keywords": [
    "mock",
    "database",
    "in-memory",
    "fixtures",
    "fetch",
    "hono",
    "storybook",
    "testing",
    "nano_kit"
  ],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./fetch": "./src/fetch/index.ts",
    "./backend": "./src/backend/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./fetch": {
        "types": "./dist/fetch/index.d.ts",
        "default": "./dist/fetch/index.js"
      },
      "./backend": {
        "types": "./dist/backend/index.d.ts",
        "default": "./dist/backend/index.js"
      }
    },
    "directory": "package",
    "linkDirectory": false
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clear:package": "del ./package",
    "clear:dist": "del ./dist",
    "clear": "del ./package ./dist ./coverage",
    "prepublishOnly": "run build clear:package clean-publish",
    "postpublish": "pnpm clear:package",
    "emitDeclarations": "tsc -p ./tsconfig.build.json --emitDeclarationOnly",
    "build:dist": "run -p emitDeclarations [ vite build ]",
    "build": "run clear:dist build:dist",
    "lint": "oxlint",
    "format": "oxlint --fix",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest watch",
    "test:types": "tsc --noEmit",
    "test": "run -p lint test:unit test:types"
  },
  "peerDependencies": {
    "hono": "^4.12.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "hono": "^4.12.31",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
